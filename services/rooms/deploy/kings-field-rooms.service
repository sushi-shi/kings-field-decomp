[Unit]
Description=King's Field multiplayer rooms and website
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/kings-field/rooms
EnvironmentFile=/etc/kings-field/rooms.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
